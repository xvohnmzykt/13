# 复制本文件为 .env 并填入本机真实配置。
# .env 已被 .gitignore 忽略，不会提交到仓库。
# 也可以不建 .env，直接在系统环境变量里设置同名的变量。

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True

# ---------- MySQL ----------
DJANGO_MYSQL_DATABASE=teaching_resource
DJANGO_MYSQL_USER=root
DJANGO_MYSQL_PASSWORD=your-mysql-password
DJANGO_MYSQL_HOST=127.0.0.1
DJANGO_MYSQL_PORT=3306

# ---------- 可选：Redis 缓存 ----------
# DJANGO_REDIS_URL=127.0.0.1:6379

# ---------- 可选：Elasticsearch 全文检索 ----------
# 设置后自动切换到 Elasticsearch，否则默认使用 Whoosh
# DJANGO_ELASTICSEARCH_HOST=http://127.0.0.1:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=your-es-password

# ---------- 可选：邮件 ----------
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=465
# DJANGO_EMAIL_USER=you@example.com
# DJANGO_EMAIL_PASSWORD=your-email-password
# DJANGO_EMAIL_SSL=True
# DJANGO_ADMIN_EMAIL=you@example.com
